{
  "expo": {
    "name": "Smoke Free",
    "slug": "smoking-tracker",
    "scheme": "smokefree",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.adziusmaster.smokefree",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f3d2e"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8ec62ea-af25-4199-99e4-b3fbf9962e00"
      }
    },
    "owner": "adrzej-dev"
  }
}
